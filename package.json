{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "yarn run update-sequence-js && docusaurus start",
    "build": "yarn run update-sequence-js && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "update-sequence-js": "((git -C sequence.js fetch origin master && git -C sequence.js reset --hard FETCH_HEAD && git -C sequence.js clean -df) || git clone https://github.com/0xsequence/sequence.js.git sequence.js) && cd sequence.js && yarn"
  },
  "dependencies": {
    "@cmfcmf/docusaurus-search-local": "^0.11.0",
    "@docusaurus/core": "^2.1.0",
    "@docusaurus/preset-classic": "^2.1.0",
    "@docusaurus/theme-search-algolia": "^2.1.0",
    "@easyops-cn/docusaurus-search-local": "^0.32.0",
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@heroicons/react": "^2.0.11",
    "@mdx-js/react": "^1.6.21",
    "@svgr/webpack": "^6.2.1",
    "clsx": "^1.1.1",
    "docusaurus-plugin-sass": "^0.2.2",
    "file-loader": "^6.2.0",
    "prism-react-renderer": "^1.2.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "sass": "^1.49.4",
    "url-loader": "^4.1.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^2.1.0",
    "@tsconfig/docusaurus": "^1.0.4",
    "@types/react": "^17.0.14",
    "@types/react-helmet": "^6.1.2",
    "@types/react-router-dom": "^5.3.3",
    "docusaurus-plugin-typedoc": "^0.17.5",
    "typedoc": "^0.23.9",
    "typedoc-plugin-markdown": "^3.13.4",
    "typescript": "^4.5.5"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "postcss-selector-parser": "^7.1.6",
    "webpack-dev-middleware": "^7.4.6",
    "image-size": "^2.0.3",
    "axios": "^0.34.0",
    "webpack-dev-server": "^5.2.6",
    "@babel/core": "^7.29.6",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "path-to-regexp": "^3.3.0",
    "node-forge": "^1.4.0",
    "minimatch": "^5.1.8",
    "semver": "^7.5.2",
    "braces": "^3.0.3",
    "eta": "^2.0.0",
    "got": "^11.8.5",
    "trim": "^0.0.3",
    "**/wait-on/axios": "^0.34.0"
  }
}
